# Use mock for local development and switch to live for the DeepSeek demo.
LLM_MODE=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
LLM_FALLBACK_TO_MOCK=true

# The agent calls the public booking REST API instead of writing through the ORM.
TOOL_API_BASE_URL=http://127.0.0.1:8000
TOOL_API_TIMEOUT_SECONDS=10

# OpenTelemetry is opt-in locally and can export to any OTLP-compatible backend.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=clinicpilot-ai
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional path overrides. Defaults are resolved from the repository root.
# DATABASE_URL=sqlite:///E:/drkudos/backend/data/clinicpilot.db
# MOCK_DATA_DIR=E:/drkudos/mock-data
# DEMO_TODAY=2026-10-26

DEFAULT_PATIENT_ID=P001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

